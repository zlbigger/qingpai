{
  "manifest_version": 3,
  "name": "轻排 · 公众号排版",
  "version": "0.18.6",
  "description": "在公众号正文编辑器里调整字体、直接插入保留原图比例的图片组合。",
  "permissions": [
    "activeTab"
  ],
  "action": {
    "default_title": "显示／收起轻排面板"
  },
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": [
        "https://mp.weixin.qq.com/*"
      ],
      "js": [
        "page-bridge.js"
      ],
      "run_at": "document_start",
      "world": "MAIN"
    },
    {
      "matches": [
        "https://mp.weixin.qq.com/*"
      ],
      "js": [
        "content.js"
      ],
      "run_at": "document_idle"
    }
  ],
  "author": "zlbigger",
  "homepage_url": "https://zlbigger.com/"
}
